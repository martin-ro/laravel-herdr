{
    "name": "martin-ro/laravel-herdr",
    "description": "A fluent, Laravel-style client for the Herdr terminal workspace socket API.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "herdr", "terminal", "socket", "multiplexer", "agents"],
    "authors": [
        {
            "name": "Martin Roph",
            "email": "martinroph@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "illuminate/contracts": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "MartinRo\\Herdr\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "MartinRo\\Herdr\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MartinRo\\Herdr\\HerdrServiceProvider"
            ],
            "aliases": {
                "Herdr": "MartinRo\\Herdr\\Facades\\Herdr"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
